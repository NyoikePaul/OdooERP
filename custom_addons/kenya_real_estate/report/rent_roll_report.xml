<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Rent Roll Action -->
  <record id="action_report_rent_roll" model="ir.actions.report">
    <field name="name">Rent Roll</field>
    <field name="model">estate.property</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">kenya_real_estate.report_rent_roll_template</field>
    <field name="report_file">kenya_real_estate.report_rent_roll_template</field>
    <field name="binding_model_id" ref="model_estate_property"/>
    <field name="binding_type">report</field>
  </record>

  <!-- Rent Roll Template -->
  <template id="report_rent_roll_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <div class="row mb-4">
            <div class="col-12 text-center">
              <h2>RENT ROLL REPORT</h2>
              <p class="text-muted">
                Generated: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y %H:%M')"/>
              </p>
            </div>
          </div>

          <!-- Summary KPIs -->
          <div class="row mb-4">
            <div class="col-3 text-center border p-3">
              <h4><t t-esc="len(docs)"/></h4>
              <small>Total Properties</small>
            </div>
            <div class="col-3 text-center border p-3">
              <h4><t t-esc="len([d for d in docs if d.status == 'leased'])"/></h4>
              <small>Leased</small>
            </div>
            <div class="col-3 text-center border p-3">
              <h4><t t-esc="len([d for d in docs if d.status == 'available'])"/></h4>
              <small>Available</small>
            </div>
            <div class="col-3 text-center border p-3">
              <h4>KES <t t-esc="'{:,.0f}'.format(sum(d.monthly_rent for d in docs if d.status == 'leased'))"/></h4>
              <small>Monthly Rent Income</small>
            </div>
          </div>

          <!-- Rent Roll Table -->
          <table class="table table-sm table-bordered">
            <thead class="table-dark">
              <tr>
                <th>Ref</th>
                <th>Property</th>
                <th>Location</th>
                <th>Type</th>
                <th>Tenant</th>
                <th>Lease Start</th>
                <th>Lease End</th>
                <th class="text-end">Monthly Rent</th>
                <th class="text-end">Arrears</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="docs" t-as="prop">
                <t t-set="lease" t-value="prop.active_lease_id"/>
                <tr>
                  <td><small><t t-esc="prop.ref"/></small></td>
                  <td><t t-esc="prop.name"/></td>
                  <td><t t-esc="prop.county or ''"/></td>
                  <td><t t-esc="dict(prop._fields['property_type'].selection).get(prop.property_type,'')"/></td>
                  <td><t t-if="lease"><t t-esc="lease.tenant_id.name"/></t></td>
                  <td><t t-if="lease"><t t-esc="lease.date_start"/></t></td>
                  <td><t t-if="lease"><t t-esc="lease.date_end"/></t></td>
                  <td class="text-end">
                    <t t-esc="'{:,.0f}'.format(prop.monthly_rent)"/>
                  </td>
                  <td class="text-end" t-att-class="'text-danger fw-bold' if (lease and lease.total_outstanding) else ''">
                    <t t-if="lease and lease.total_outstanding">
                      <t t-esc="'{:,.0f}'.format(lease.total_outstanding)"/>
                    </t>
                    <t t-else="">—</t>
                  </td>
                  <td>
                    <span t-att-class="'badge bg-success' if prop.status == 'available' else 'badge bg-primary' if prop.status == 'leased' else 'badge bg-secondary'">
                      <t t-esc="prop.status.replace('_',' ').title()"/>
                    </span>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot class="table-secondary fw-bold">
              <tr>
                <td colspan="7">TOTALS</td>
                <td class="text-end">KES <t t-esc="'{:,.0f}'.format(sum(d.monthly_rent for d in docs))"/></td>
                <td class="text-end text-danger">
                  KES <t t-esc="'{:,.0f}'.format(sum(l.total_outstanding for d in docs for l in [d.active_lease_id] if l))"/>
                </td>
                <td></td>
              </tr>
            </tfoot>
          </table>
          <small class="text-muted">Generated by OdooERP Kenya · github.com/NyoikePaul/OdooERP · LGPL-3</small>
        </div>
      </t>
    </t>
  </template>

  <!-- Arrears Report Action -->
  <record id="action_report_arrears" model="ir.actions.report">
    <field name="name">Rent Arrears Report</field>
    <field name="model">estate.lease</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">kenya_real_estate.report_arrears_template</field>
    <field name="report_file">kenya_real_estate.report_arrears_template</field>
    <field name="binding_model_id" ref="model_estate_lease"/>
    <field name="binding_type">report</field>
  </record>

  <!-- Arrears Report Template -->
  <template id="report_arrears_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2 class="text-center mb-4">RENT ARREARS REPORT</h2>
          <p class="text-center text-muted">As at <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/></p>

          <table class="table table-sm table-bordered">
            <thead class="table-danger">
              <tr>
                <th>Lease Ref</th>
                <th>Property</th>
                <th>Tenant</th>
                <th>Phone</th>
                <th class="text-end">Monthly Rent</th>
                <th class="text-end">Total Outstanding</th>
                <th class="text-end">Months Arrears</th>
                <th>Days to Expiry</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="docs" t-as="lease">
                <t t-if="lease.total_outstanding &gt; 0">
                  <tr>
                    <td><t t-esc="lease.name"/></td>
                    <td><t t-esc="lease.property_id.name"/></td>
                    <td><t t-esc="lease.tenant_id.name"/></td>
                    <td><t t-esc="lease.tenant_id.phone or '—'"/></td>
                    <td class="text-end"><t t-esc="'{:,.0f}'.format(lease.monthly_rent)"/></td>
                    <td class="text-end fw-bold text-danger"><t t-esc="'{:,.0f}'.format(lease.total_outstanding)"/></td>
                    <td class="text-center"><t t-esc="lease.months_outstanding"/></td>
                    <td class="text-center" t-att-class="'text-warning' if lease.days_to_expiry &lt; 30 else ''">
                      <t t-esc="lease.days_to_expiry"/> days
                    </td>
                  </tr>
                </t>
              </t>
            </tbody>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
