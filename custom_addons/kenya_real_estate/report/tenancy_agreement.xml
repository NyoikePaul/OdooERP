<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_tenancy_agreement" model="ir.actions.report">
    <field name="name">Tenancy Agreement</field>
    <field name="model">estate.lease</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">kenya_real_estate.report_tenancy_agreement</field>
    <field name="binding_model_id" ref="model_estate_lease"/>
    <field name="binding_type">report</field>
  </record>
  <template id="report_tenancy_agreement">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2 class="text-center mb-2">TENANCY AGREEMENT</h2>
          <p class="text-center text-muted mb-4">Kenya Landlord and Tenant Act — Cap 301</p>
          <t t-foreach="docs" t-as="lease">
            <div class="mb-4">
              <p>This Tenancy Agreement is entered into on <strong><t t-esc="lease.date_start"/></strong> between:</p>
              <p><strong>LANDLORD:</strong> <t t-esc="lease.property_id.landlord_id.name"/></p>
              <p><strong>TENANT:</strong> <t t-esc="lease.tenant_id.name"/></p>
              <p><strong>PROPERTY:</strong> <t t-esc="lease.property_id.name"/>, <t t-esc="lease.property_id.street or ''"/>, <t t-esc="lease.property_id.county or ''"/></p>
              <hr/>
              <h4>TERMS</h4>
              <table class="table table-bordered table-sm">
                <tr><th>Lease Ref</th><td><t t-esc="lease.name"/></td><th>Start Date</th><td><t t-esc="lease.date_start"/></td></tr>
                <tr><th>End Date</th><td><t t-esc="lease.date_end"/></td><th>Duration</th><td><t t-esc="lease.duration_months"/> months</td></tr>
                <tr><th>Monthly Rent</th><td>KES <t t-esc="'{:,.0f}'.format(lease.monthly_rent)"/></td><th>Service Charge</th><td>KES <t t-esc="'{:,.0f}'.format(lease.service_charge)"/></td></tr>
                <tr><th>Security Deposit</th><td>KES <t t-esc="'{:,.0f}'.format(lease.deposit)"/></td><th>Notice Period</th><td><t t-esc="lease.notice_period"/> days</td></tr>
                <tr><th>WHT Rate</th><td><t t-esc="lease.wht_rate"/>%</td><th>Landlord Payout</th><td>KES <t t-esc="'{:,.0f}'.format(lease.landlord_payout)"/>/mo</td></tr>
              </table>
              <h4>SPECIAL CONDITIONS</h4>
              <p><t t-esc="lease.notes or 'None'"/></p>
              <div class="row mt-5">
                <div class="col-6"><p>________________________</p><p>Landlord Signature &amp; Date</p></div>
                <div class="col-6"><p>________________________</p><p>Tenant Signature &amp; Date</p></div>
              </div>
            </div>
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>
