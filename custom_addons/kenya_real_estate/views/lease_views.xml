<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="estate_lease_view_list" model="ir.ui.view">
    <field name="name">estate.lease.list</field>
    <field name="model">estate.lease</field>
    <field name="arch" type="xml">
      <list string="Leases"
            decoration-success="status=='active' and not is_expiring_soon"
            decoration-warning="is_expiring_soon"
            decoration-muted="status in ('expired','cancelled')"
            decoration-info="status=='renewed'">
        <field name="name"/>
        <field name="property_id"/>
        <field name="tenant_id"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="duration_months"/>
        <field name="monthly_rent"/>
        <field name="total_paid"/>
        <field name="total_outstanding"/>
        <field name="days_to_expiry"/>
        <field name="is_expiring_soon" invisible="1"/>
        <field name="status" widget="badge"
               decoration-success="status=='active'"
               decoration-warning="status=='draft'"
               decoration-muted="status in ('expired','cancelled')"/>
      </list>
    </field>
  </record>

  <record id="estate_lease_view_form" model="ir.ui.view">
    <field name="name">estate.lease.form</field>
    <field name="model">estate.lease</field>
    <field name="arch" type="xml">
      <form string="Lease">
        <header>
          <button name="action_activate" string="Activate" type="object"
                  invisible="status != 'draft'" class="oe_highlight"/>
          <button name="action_renew" string="Renew Lease" type="object"
                  invisible="status not in ('active','expired')" class="btn-primary"/>
          <button name="action_generate_rent_invoice" string="Generate Rent Invoice"
                  type="object" invisible="status != 'active'" class="btn-secondary"/>
          <button name="action_cancel" string="Cancel" type="object"
                  invisible="status in ('cancelled','expired','renewed')"/>
          <field name="status" widget="statusbar"
                 statusbar_visible="draft,active,expired"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_invoices" type="object"
                    class="oe_stat_button" icon="fa-money">
              <field name="payment_count" widget="statinfo" string="Invoices"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <div t-if="is_expiring_soon" class="alert alert-warning" role="alert">
            ⚠️ This lease expires in <strong><field name="days_to_expiry"/></strong> days!
          </div>
          <group>
            <group string="Lease Details">
              <field name="property_id"/>
              <field name="tenant_id"/>
              <field name="parent_lease_id" readonly="1"/>
            </group>
            <group string="Dates">
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="duration_months" readonly="1"/>
              <field name="days_to_expiry" readonly="1"/>
              <field name="notice_period"/>
              <field name="notice_given"/>
              <field name="notice_date" invisible="not notice_given"/>
            </group>
          </group>
          <group string="Financials">
            <group>
              <field name="monthly_rent"/>
              <field name="deposit"/>
              <field name="deposit_paid"/>
              <field name="penalty_rate"/>
            </group>
            <group>
              <field name="total_paid" readonly="1"/>
              <field name="total_outstanding" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Rent Invoices">
              <field name="payment_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="invoice_date"/>
                  <field name="invoice_date_due"/>
                  <field name="amount_total"/>
                  <field name="amount_residual"/>
                  <field name="payment_state" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Renewals">
              <field name="renewal_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="date_start"/>
                  <field name="date_end"/>
                  <field name="monthly_rent"/>
                  <field name="status" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="estate_lease_action" model="ir.actions.act_window">
    <field name="name">Leases</field>
    <field name="res_model">estate.lease</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
