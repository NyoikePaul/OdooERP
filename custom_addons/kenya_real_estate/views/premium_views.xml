<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ════ OFFERS ════ -->
  <record id="estate_offer_view_list" model="ir.ui.view">
    <field name="name">estate.offer.list</field>
    <field name="model">estate.offer</field>
    <field name="arch" type="xml">
      <list string="Offers &amp; Enquiries"
            decoration-success="status=='accepted'"
            decoration-danger="status=='refused'"
            decoration-warning="status=='viewing'"
            decoration-muted="status=='expired'">
        <field name="create_date" string="Date"/>
        <field name="property_id"/>
        <field name="partner_id"/>
        <field name="offer_type"/>
        <field name="listing_price"/>
        <field name="offer_amount"/>
        <field name="deadline"/>
        <field name="status" widget="badge"/>
        <button name="action_accept"          type="object" string="Accept"  icon="fa-check"   invisible="status != 'new'"/>
        <button name="action_refuse"          type="object" string="Refuse"  icon="fa-times"   invisible="status not in ('new','viewing')"/>
        <button name="action_schedule_viewing" type="object" string="View"   icon="fa-calendar" invisible="status != 'new'"/>
      </list>
    </field>
  </record>
  <record id="estate_offer_view_form" model="ir.ui.view">
    <field name="name">estate.offer.form</field>
    <field name="model">estate.offer</field>
    <field name="arch" type="xml">
      <form string="Offer / Enquiry">
        <header>
          <button name="action_schedule_viewing" type="object" string="Schedule Viewing"
                  invisible="status != 'new'"/>
          <button name="action_accept" type="object" string="Accept Offer"
                  invisible="status != 'new'" class="oe_highlight"/>
          <button name="action_refuse" type="object" string="Refuse"
                  invisible="status in ('refused','accepted','expired')"/>
          <field name="status" widget="statusbar" statusbar_visible="new,viewing,accepted"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="property_id"/>
              <field name="unit_id"/>
              <field name="partner_id"/>
              <field name="offer_type"/>
            </group>
            <group>
              <field name="listing_price"/>
              <field name="offer_amount"/>
              <field name="deadline"/>
            </group>
          </group>
          <field name="notes"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="estate_offer_action" model="ir.actions.act_window">
    <field name="name">Offers &amp; Enquiries</field>
    <field name="res_model">estate.offer</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ════ INSPECTIONS ════ -->
  <record id="estate_inspection_view_list" model="ir.ui.view">
    <field name="name">estate.inspection.list</field>
    <field name="model">estate.inspection</field>
    <field name="arch" type="xml">
      <list string="Inspection Reports"
            decoration-success="overall_condition in ('excellent','good')"
            decoration-warning="overall_condition=='fair'"
            decoration-danger="overall_condition=='poor'">
        <field name="name"/>
        <field name="property_id"/>
        <field name="inspection_type"/>
        <field name="date"/>
        <field name="inspector_id"/>
        <field name="tenant_id"/>
        <field name="overall_condition" widget="badge"/>
        <field name="deduction_amount"/>
        <field name="signed_tenant" widget="boolean_toggle"/>
        <field name="signed_landlord" widget="boolean_toggle"/>
      </list>
    </field>
  </record>
  <record id="estate_inspection_view_form" model="ir.ui.view">
    <field name="name">estate.inspection.form</field>
    <field name="model">estate.inspection</field>
    <field name="arch" type="xml">
      <form string="Inspection Report">
        <header>
          <button name="action_generate_default_checklist" type="object"
                  string="Generate Checklist" class="btn-secondary"/>
          <field name="overall_condition" widget="statusbar"
                 statusbar_visible="excellent,good,fair,poor"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="inspection_type"/>
              <field name="property_id"/>
              <field name="unit_id"/>
              <field name="lease_id"/>
            </group>
            <group>
              <field name="date"/>
              <field name="inspector_id"/>
              <field name="tenant_id"/>
              <field name="overall_condition"/>
            </group>
          </group>
          <group string="Signatures &amp; Deductions">
            <field name="signed_tenant"/>
            <field name="signed_landlord"/>
            <field name="deduction_amount"/>
          </group>
          <notebook>
            <page string="Checklist">
              <field name="item_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="room"/>
                  <field name="condition" widget="badge"/>
                  <field name="description"/>
                  <field name="deduction"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="estate_inspection_action" model="ir.actions.act_window">
    <field name="name">Inspection Reports</field>
    <field name="res_model">estate.inspection</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ════ COMMISSIONS ════ -->
  <record id="estate_commission_view_list" model="ir.ui.view">
    <field name="name">estate.commission.list</field>
    <field name="model">estate.commission</field>
    <field name="arch" type="xml">
      <list string="Commissions"
            decoration-success="status=='paid'"
            decoration-warning="status=='approved'"
            decoration-muted="status=='cancelled'">
        <field name="name"/>
        <field name="agent_id"/>
        <field name="property_id"/>
        <field name="commission_type"/>
        <field name="basis"/>
        <field name="base_amount"/>
        <field name="rate"/>
        <field name="commission_amount" sum="Total"/>
        <field name="status" widget="badge"/>
        <button name="action_approve" type="object" string="Approve"
                icon="fa-check" invisible="status != 'draft'"/>
        <button name="action_create_invoice" type="object" string="Invoice"
                icon="fa-file" invisible="status != 'approved'"/>
      </list>
    </field>
  </record>
  <record id="estate_commission_action" model="ir.actions.act_window">
    <field name="name">Agent Commissions</field>
    <field name="res_model">estate.commission</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ════ DEPOSITS ════ -->
  <record id="estate_deposit_view_list" model="ir.ui.view">
    <field name="name">estate.deposit.list</field>
    <field name="model">estate.deposit</field>
    <field name="arch" type="xml">
      <list string="Security Deposits"
            decoration-success="status=='refunded'"
            decoration-warning="status=='held'"
            decoration-danger="status=='forfeited'">
        <field name="name"/>
        <field name="lease_id"/>
        <field name="tenant_id"/>
        <field name="property_id"/>
        <field name="deposit_amount"/>
        <field name="total_deductions"/>
        <field name="refund_amount"/>
        <field name="received_via"/>
        <field name="status" widget="badge"/>
        <button name="action_refund" type="object" string="Refund"
                icon="fa-money" invisible="status != 'held'"/>
      </list>
    </field>
  </record>
  <record id="estate_deposit_view_form" model="ir.ui.view">
    <field name="name">estate.deposit.form</field>
    <field name="model">estate.deposit</field>
    <field name="arch" type="xml">
      <form string="Security Deposit">
        <header>
          <button name="action_refund" type="object" string="Mark Refunded"
                  invisible="status != 'held'" class="oe_highlight"/>
          <button name="action_forfeit" type="object" string="Forfeit"
                  invisible="status != 'held'"/>
          <field name="status" widget="statusbar" statusbar_visible="held,refunded"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="lease_id"/>
              <field name="tenant_id" readonly="1"/>
              <field name="property_id" readonly="1"/>
            </group>
            <group>
              <field name="deposit_amount"/>
              <field name="received_date"/>
              <field name="received_via"/>
              <field name="mpesa_receipt"/>
            </group>
          </group>
          <group string="Summary">
            <field name="total_deductions" readonly="1"/>
            <field name="refund_amount" readonly="1"/>
            <field name="refund_date"/>
            <field name="refund_ref"/>
          </group>
          <notebook>
            <page string="Deductions">
              <field name="deduction_ids">
                <list editable="bottom">
                  <field name="description"/>
                  <field name="amount"/>
                  <field name="maintenance_id"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="estate_deposit_action" model="ir.actions.act_window">
    <field name="name">Security Deposits</field>
    <field name="res_model">estate.deposit</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ════ BUILDINGS ════ -->
  <record id="estate_building_view_list" model="ir.ui.view">
    <field name="name">estate.building.list</field>
    <field name="model">estate.building</field>
    <field name="arch" type="xml">
      <list string="Buildings">
        <field name="ref"/>
        <field name="name"/>
        <field name="county"/>
        <field name="landlord_id"/>
        <field name="unit_count"/>
        <field name="occupied"/>
        <field name="vacant"/>
        <field name="occupancy_rate" widget="percentage"/>
      </list>
    </field>
  </record>
  <record id="estate_building_view_form" model="ir.ui.view">
    <field name="name">estate.building.form</field>
    <field name="model">estate.building</field>
    <field name="arch" type="xml">
      <form string="Building">
        <sheet>
          <field name="image_1920" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <h1><field name="name"/></h1>
            <h4><field name="ref" readonly="1"/></h4>
          </div>
          <group>
            <group>
              <field name="landlord_id"/>
              <field name="agent_id"/>
              <field name="street"/>
              <field name="county"/>
            </group>
            <group>
              <field name="year_built"/>
              <field name="total_floors"/>
              <field name="unit_count"/>
              <field name="occupancy_rate" widget="percentage"/>
            </group>
          </group>
          <notebook>
            <page string="Units">
              <field name="unit_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="floor"/>
                  <field name="unit_type"/>
                  <field name="size_sqft"/>
                  <field name="monthly_rent"/>
                  <field name="status" widget="badge"/>
                  <field name="tenant_id"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="estate_building_action" model="ir.actions.act_window">
    <field name="name">Buildings</field>
    <field name="res_model">estate.building</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ════ UTILITY READINGS ════ -->
  <record id="estate_utility_reading_view_list" model="ir.ui.view">
    <field name="name">estate.utility.reading.list</field>
    <field name="model">estate.utility.reading</field>
    <field name="arch" type="xml">
      <list string="Utility Readings"
            decoration-warning="not invoiced">
        <field name="reading_date"/>
        <field name="meter_id"/>
        <field name="lease_id"/>
        <field name="previous"/>
        <field name="current"/>
        <field name="consumed"/>
        <field name="amount" sum="Total"/>
        <field name="invoiced" widget="boolean_toggle"/>
        <button name="action_create_invoice" type="object"
                string="Invoice" icon="fa-file"
                invisible="invoiced"/>
      </list>
    </field>
  </record>
  <record id="estate_utility_reading_action" model="ir.actions.act_window">
    <field name="name">Utility Readings</field>
    <field name="res_model">estate.utility.reading</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
