<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Property Type -->
  <record id="estate_property_type_view_list" model="ir.ui.view">
    <field name="name">estate.property.type.list</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
      <list string="Property Types" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="property_count"/>
      </list>
    </field>
  </record>
  <record id="estate_property_type_action" model="ir.actions.act_window">
    <field name="name">Property Types</field>
    <field name="res_model">estate.property.type</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Amenity -->
  <record id="estate_amenity_view_list" model="ir.ui.view">
    <field name="name">estate.amenity.list</field>
    <field name="model">estate.amenity</field>
    <field name="arch" type="xml">
      <list string="Amenities" editable="bottom">
        <field name="name"/>
        <field name="category"/>
        <field name="icon"/>
      </list>
    </field>
  </record>
  <record id="estate_amenity_action" model="ir.actions.act_window">
    <field name="name">Amenities</field>
    <field name="res_model">estate.amenity</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Tag -->
  <record id="estate_tag_view_list" model="ir.ui.view">
    <field name="name">estate.property.tag.list</field>
    <field name="model">estate.property.tag</field>
    <field name="arch" type="xml">
      <list string="Tags" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>
  <record id="estate_tag_action" model="ir.actions.act_window">
    <field name="name">Property Tags</field>
    <field name="res_model">estate.property.tag</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
