<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="estate_building_view_list" model="ir.ui.view">
    <field name="name">estate.building.list</field>
    <field name="model">estate.building</field>
    <field name="arch" type="xml">
      <list string="Buildings">
        <field name="ref"/>
        <field name="name"/>
        <field name="county"/>
        <field name="landlord_id"/>
        <field name="unit_count"/>
        <field name="occupied"/>
        <field name="vacant"/>
        <field name="occupancy_rate" widget="percentage"/>
        <field name="total_monthly_income" sum="Total Income"/>
      </list>
    </field>
  </record>
  <record id="estate_building_view_form" model="ir.ui.view">
    <field name="name">estate.building.form</field>
    <field name="model">estate.building</field>
    <field name="arch" type="xml">
      <form string="Building">
        <sheet>
          <field name="image_1920" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <h1><field name="name"/></h1>
            <h4 class="text-muted"><field name="ref" readonly="1"/></h4>
          </div>
          <group>
            <group>
              <field name="landlord_id"/>
              <field name="manager_id"/>
              <field name="street"/>
              <field name="county"/>
              <field name="year_built"/>
              <field name="total_floors"/>
            </group>
            <group string="Facilities">
              <field name="has_lift"/>
              <field name="has_generator"/>
              <field name="has_borehole"/>
              <separator string="Occupancy"/>
              <field name="unit_count"     readonly="1"/>
              <field name="occupancy_rate" readonly="1" widget="percentage"/>
              <field name="total_monthly_income" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Units">
              <field name="unit_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="floor"/>
                  <field name="unit_type"/>
                  <field name="size_sqft"/>
                  <field name="monthly_rent"/>
                  <field name="status" widget="badge"
                         decoration-success="status=='vacant'"
                         decoration-info="status=='leased'"/>
                  <field name="tenant_id" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="estate_building_action" model="ir.actions.act_window">
    <field name="name">Buildings</field>
    <field name="res_model">estate.building</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
