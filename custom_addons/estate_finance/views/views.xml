<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Owner Statements -->
  <record id="estate_owner_statement_view_list" model="ir.ui.view">
    <field name="name">estate.owner.statement.list</field>
    <field name="model">estate.owner.statement</field>
    <field name="arch" type="xml">
      <list string="Owner Statements" decoration-success="status=='sent'">
        <field name="name"/>
        <field name="landlord_id"/>
        <field name="period_month"/>
        <field name="period_year"/>
        <field name="total_income"/>
        <field name="total_deductions"/>
        <field name="net_payout"/>
        <field name="status" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="estate_owner_statement_view_form" model="ir.ui.view">
    <field name="name">estate.owner.statement.form</field>
    <field name="model">estate.owner.statement</field>
    <field name="arch" type="xml">
      <form string="Owner Statement">
        <header>
          <field name="status" widget="statusbar" statusbar_visible="draft,sent"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="landlord_id"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="period_month"/>
              <field name="period_year"/>
            </group>
          </group>
          <group string="Income">
            <field name="gross_rent_collected"/>
            <field name="other_income"/>
            <field name="total_income"/>
          </group>
          <group string="Deductions">
            <field name="management_fee_pct"/>
            <field name="management_fee"/>
            <field name="wht_deducted"/>
            <field name="maintenance_costs"/>
            <field name="insurance_costs"/>
            <field name="other_deductions"/>
            <field name="total_deductions"/>
          </group>
          <group string="Payout">
            <field name="net_payout"/>
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="property_id"/>
              <field name="lease_id"/>
              <field name="tenant_id"/>
              <field name="rent_due"/>
              <field name="rent_collected"/>
              <field name="wht"/>
              <field name="net_to_owner"/>
            </list>
          </field>
          <field name="notes"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="estate_owner_statement_action" model="ir.actions.act_window">
    <field name="name">Owner Statements</field>
    <field name="res_model">estate.owner.statement</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Payment Aging -->
  <record id="estate_payment_aging_view_list" model="ir.ui.view">
    <field name="name">estate.payment.aging.list</field>
    <field name="model">estate.payment.aging</field>
    <field name="arch" type="xml">
      <list string="Payment Aging">
        <field name="tenant_id"/>
        <field name="property_id"/>
        <field name="lease_id"/>
        <field name="current"/>
        <field name="days_1_30"/>
        <field name="days_31_60"/>
        <field name="days_61_90"/>
        <field name="days_90_plus"/>
        <field name="total_outstanding"/>
      </list>
    </field>
  </record>

  <record id="estate_payment_aging_action" model="ir.actions.act_window">
    <field name="name">Payment Aging</field>
    <field name="res_model">estate.payment.aging</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
