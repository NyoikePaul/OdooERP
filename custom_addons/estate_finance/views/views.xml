<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Owner Statements -->
  <record id="estate_owner_statement_view_list" model="ir.ui.view">
    <field name="name">estate.owner.statement.list</field>
    <field name="model">estate.owner.statement</field>
    <field name="arch" type="xml">
      <list string="Owner Statements" decoration-info="state=='draft'" decoration-success="state=='sent'">
        <field name="name"/>
        <field name="property_id"/>
        <field name="landlord_id"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="total_income"/>
        <field name="total_expenses"/>
        <field name="net_payout"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="estate_owner_statement_view_form" model="ir.ui.view">
    <field name="name">estate.owner.statement.form</field>
    <field name="model">estate.owner.statement</field>
    <field name="arch" type="xml">
      <form string="Owner Statement">
        <header>
          <button name="action_send" string="Send to Owner" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="property_id"/>
              <field name="landlord_id"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="date"/>
              <field name="description"/>
              <field name="category"/>
              <field name="amount"/>
            </list>
          </field>
          <group class="oe_subtotal_footer">
            <field name="total_income"/>
            <field name="total_expenses"/>
            <field name="net_payout"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="estate_owner_statement_action" model="ir.actions.act_window">
    <field name="name">Owner Statements</field>
    <field name="res_model">estate.owner.statement</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Payment Aging -->
  <record id="estate_payment_aging_view_list" model="ir.ui.view">
    <field name="name">estate.payment.aging.list</field>
    <field name="model">estate.payment.aging</field>
    <field name="arch" type="xml">
      <list string="Payment Aging">
        <field name="tenant_id"/>
        <field name="property_id"/>
        <field name="current_balance"/>
        <field name="days_30"/>
        <field name="days_60"/>
        <field name="days_90"/>
        <field name="days_90_plus"/>
        <field name="total_outstanding"/>
      </list>
    </field>
  </record>

  <record id="estate_payment_aging_action" model="ir.actions.act_window">
    <field name="name">Payment Aging</field>
    <field name="res_model">estate.payment.aging</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
