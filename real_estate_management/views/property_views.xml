<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_real_estate_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="total_area"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Luxury Apartment in Kilimani"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification &amp; Finances">
                            <field name="property_type_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="postcode"/>
                            <field name="expected_price"/>
                            <field name="rent_amount"/>
                            <field name="selling_price"/>
                        </group>
                        <group string="Dimensional Matrix">
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="garden"/>
                            <field name="garden_area" invisible="not garden"/>
                            <field name="total_area"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview &amp; Description">
                            <field name="description" placeholder="Enter structural notes, neighborhood details..."/>
                        </page>
                        <page string="Offers &amp; Bidding Logs">
                            <field name="offer_ids">
                                <list editable="bottom" decoration-success="status=='accepted'" decoration-danger="status=='refused'">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_real_estate_root" name="Real Estate" sequence="10"/>
    <menuitem id="menu_real_estate_listings" name="Listings" parent="menu_real_estate_root" sequence="10"/>
    <menuitem id="menu_real_estate_property" name="Properties" parent="menu_real_estate_listings" action="action_real_estate_property" sequence="10"/>
    
    <menuitem id="menu_real_estate_settings" name="Configuration" parent="menu_real_estate_root" sequence="100"/>
    <menuitem id="menu_property_type" name="Property Types" parent="menu_real_estate_settings" action="action_real_estate_property_type" sequence="10"/>
</odoo>
